+/*
+ * Direct-write paths call this when the mixing engine is off. While Windows
+ * exposes no playback endpoint, discard the samples at the virtual clock rate
+ * instead of buffering them: nothing drains the emulated ring without a device
+ * and virtio-sound would stall waiting for space. The default mixing-engine
+ * path is paced by sdl_silence_out() instead.
+ */
+static size_t sdl_write(HWVoiceOut *hw, void *buf, size_t size)
+{
+    SDLVoiceOut *sdl = (SDLVoiceOut *)hw;
+    size_t written;
+
+    sdl_refresh_route_Out(sdl);
+    if (!sdl->devid) {
+        return audio_rate_get_bytes(&sdl->silence_rate, &hw->info, size);
+    }
+    SDL_LockAudioDevice(sdl->devid);
+    written = audio_generic_write(hw, buf, size);
+    SDL_UnlockAudioDevice(sdl->devid);
+    return written;
+}
