+/* SDL keeps a cached inventory; an attempted WASAPI open of a device that
+ * disappeared blocks for about eight seconds. Leave ten seconds after a failed
+ * open of a listed endpoint, and retry every second while Windows exposes no
+ * playback device at all.
+ */
+static void sdl_backoff_out(SDLVoiceOut *sdl)
+{
+    int seconds = SDL_GetNumAudioDevices(0) > 0 ? 10 : 1;
+
+    sdl->next_route_check = g_get_monotonic_time() + seconds * G_USEC_PER_SEC;
+}
+
+/*
+ * Nothing drains the emulated output ring while SDL has no playback device.
+ * Discard whatever the mixing engine already staged, at the virtual clock
+ * rate, so the ring keeps accepting guest PCM instead of stalling
+ * virtio-sound when a backend write returns space that never appears.
+ */
+static void sdl_silence_out(SDLVoiceOut *sdl)
+{
+    HWVoiceOut *hw = &sdl->hw;
+    size_t bytes = audio_rate_get_bytes(&sdl->silence_rate, &hw->info,
+                                       hw->pending_emul);
+
+    hw->pending_emul -= bytes;
+}
